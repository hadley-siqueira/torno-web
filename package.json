{
  "name": "torno-cnc-web",
  "version": "0.1.0",
  "description": "Simulador web simples de torno CNC (G-code) com Three.js/WebGL",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"test/unit/*.test.js\" \"test/api/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"shared/**\" --test-coverage-include=\"server/**\" \"test/unit/*.test.js\" \"test/api/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "three": "^0.187.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
