; Bucha roscada M30 x 1,5 com ciclos: CYCLE95 externo e interno, CYCLE97 interno
; Bruto: D50 x 70 mm, face em Z1
; Material: bronze
; Torre: sinutrain
; T1 desbaste, T14 broca de centro, T15 broca D16, T4 desbaste interno,
; T7 acabamento interno, T16 rosca interna, T13 bedame de corte
G18 G90 G95 DIAMON

; ========== FACEAMENTO (T1) ==========
T1 D1
G96 S180 LIMS=2500 M4
G0 X54 Z0
G1 X-1.6 F0.2
G0 X54 Z3

; ========== EXTERNO: DESBASTE E ACABAMENTO (T1, VARI=9) ==========
CYCLE95("EXTERNO:EXTERNO_FIM", 2, 0.1, 0.2, , 0.25, 0.15, 0.12, 9, , , 1)
G0 X150 Z100

; ========== FURO DE CENTRO (T14) ==========
T14 D1
G97 S1200 M3
G0 X0 Z3
G1 Z-4 F0.08
G0 Z5
G0 X150 Z100

; ========== FURO PASSANTE D16 (T15), COM ALIVIO DE CAVACO ==========
T15 D1
G97 S600 M3
G0 X0 Z3
G1 Z-15 F0.12
G0 Z2
G0 Z-14
G1 Z-30
G0 Z2
G0 Z-29
G1 Z-52                   ; a ponta conica passa do fim do contorno interno (Z-44)
G0 Z5
G0 X150 Z100

; ========== INTERNO: DESBASTE (T4, VARI=3) ==========
; furo da rosca D28,38 ate Z-12 e furo D24 ate o fim
T4 D1
G96 S150 LIMS=2000 M3
G0 X14 Z3
CYCLE95("INTERNO:INTERNO_FIM", 1.5, 0.1, 0.2, , 0.2, 0.1, 0.1, 3, , , 0.5)
G0 Z50
G0 X150 Z100

; ========== INTERNO: ACABAMENTO (T7, VARI=7) ==========
T7 D1
G96 S180 LIMS=2500 M3
G0 X14 Z3
CYCLE95("INTERNO:INTERNO_FIM", , , , , , , 0.08, 7, , , 0.5)
G0 Z50
G0 X150 Z100

; ========== ROSCA INTERNA M30 x 1,5 (T16, VARI=2) ==========
; DM = D do furo (28,38); profundidade 0,81; ate Z-10 com saida de 1 mm
T16 D1
G97 S500 M3
G0 X26 Z5
CYCLE97(1.5, , 0, -10, 28.38, 28.38, 4, 1, 0.81, 0.05, 30, 0, 5, 1, 2, 1, 0.5)
G0 Z50
G0 X150 Z100

; ========== CORTE (T13) ==========
T13 D1
G97 S700 M4
G0 X54 Z-40
G1 X20 F0.08
G0 X54
G0 X150 Z100
M30

; ---------- contornos (lidos pelos ciclos) ----------
EXTERNO:
G1 X40 Z1
X44 Z-1
Z-44
X52
EXTERNO_FIM:

INTERNO:
G1 X30.38 Z1
X28.38 Z-1
Z-12
X24
Z-44
X16
INTERNO_FIM:
